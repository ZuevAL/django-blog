{
  "model": "blog.post",
  "pk": 3,
  "fields": {
    "title": "Информативный пост",
    "slug": "informativnyj-post",
    "author": 1,
    "body": "Django — бесплатный высокоуровневый фреймворк с открытым исходным кодом для создания приложений на языке Python. Его основная цель — помочь разработчикам быстро и безопасно создавать серверную часть сайтов.",
    "publish": "2026-02-04T15:14:58Z",
